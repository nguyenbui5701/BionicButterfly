    "raw_order": [
      "P_INPUT_TOO_LARGE",
      "P_UTF8_INVALID",
      "P_UTF8_BOM"
    ],
    "schema_rule": "first path from canonical schema traversal; special-case tag/version/context and event maxItems before generic enum/range; deterministic type precedence",
