  "policy_variant_mutations": {
    "EXACT": "No alteration; pass exact file bytes without adding newline",
    "BYTE_FLIP": "Replace first raw byte 0x7b (ASCII {) with 0x5b (ASCII [); do not decode or repair malformed JSON",
    "TRAILING_LF": "Append exactly one LF byte 0x0a to original canonical raw policy bytes",
    "LEADING_BOM": "Prefix UTF-8 BOM bytes ef bb bf to original canonical raw policy bytes",
    "WHITESPACE": "Replace the first raw colon byte 0x3a with colon+ASCII space bytes 3a 20",
    "REORDERED_KEYS": "Decode original ASCII JSON, construct root dict with reversed original key insertion order, then dumps with separators=(comma,colon), ensure_ascii=True, sort_keys=False, encoding ASCII; keys have changed order even though domain values match",
    "STEP_10000": "Replace exact byte substring b'\"scheduler_step_us\":5000' with b'\"scheduler_step_us\":10000', assert it occurred exactly once",
    "OWNER_USER": "Replace exact byte substring b'\"owner\":\"SIMULATOR\"' with b'\"owner\":\"USER\"', assert one occurrence",
    "APPROVED_TRUE_KEY": "Replace the final closing byte of the root JSON } with ASCII bytes ,\"approved\":true}; preserve all other bytes",
    "EMPTY": "Pass b'' as exact policy bytes",
    "INVALID_UTF8": "Pass b'\\xff' as exact policy bytes; E2 computes its digest without decoding",
    "RF_TIMEOUT_200001": "Replace exact byte substring b'\"rf_status_timeout_us\":200000' with b'\"rf_status_timeout_us\":200001', assert one occurrence"
  },
  "wire_variant_mutations": {
    "VALID_MINIMAL": "Use exact P210_MINIMAL_WIRE_V2.json bytes; no modification",
    "UNKNOWN_APPROVED": "Decode legal minimal JSON, set illegal top-level approved=true, reserialize UTF-8",
    "UNKNOWN_OWNER": "Decode legal minimal JSON, set illegal top-level owner=\"SIMULATOR\", reserialize UTF-8",
    "UNKNOWN_SINK": "Decode legal minimal JSON, set illegal top-level output_adapter=\"PWM\", reserialize UTF-8",
    "UNKNOWN_ALLOWLIST": "Decode legal minimal JSON, set illegal top-level policy_allowlist=[\"fake\"], reserialize UTF-8",
    "UNKNOWN_ENGINE": "Decode legal minimal JSON, set illegal top-level engine_revision=\"G0A1_E2_TEST_ENGINE_ONLY\", reserialize UTF-8",
    "UNKNOWN_SCHEDULER": "Decode legal minimal JSON, set illegal top-level scheduler_revision=\"G0A1_E2_TEST_SCHEDULER_ONLY\", reserialize UTF-8",
    "WRONG_CONTEXT": "Decode legal minimal JSON, replace top-level context with \"RC_PRIMARY\", reserialize UTF-8",
    "WRONG_VERSION": "Decode legal minimal JSON, replace schema_version integer 2 with integer 1, reserialize UTF-8",
    "WRONG_PROVENANCE": "Decode legal minimal JSON, replace provenance with \"RF_PRIMARY\", reserialize UTF-8",
    "WRONG_CONFIG": "Decode legal minimal JSON, replace config_id with \"unauthorized-config\", reserialize UTF-8",
    "WRONG_CLOCK": "Decode legal minimal JSON, replace clock.step_us integer 5000 with integer 10000, reserialize UTF-8",
    "UNKNOWN_EVENT": "Decode legal minimal JSON, append at time 5000 a legal-shape event with event_id=\"illegal\", type=\"UNSUPPORTED_EVENT\", payload={}, reserialize UTF-8",
    "DUPLICATE_BOOT": "Decode legal minimal JSON, append at time 5000 an event with event_id=\"boot-two\", type=\"BOOT\", payload={}, reserialize UTF-8",
    "WIRE_BOM": "Prefix BOM bytes ef bb bf to otherwise exact legal P210 wire bytes",
    "DUPLICATE_JSON_KEY": "Take otherwise legal minimal raw JSON bytes and insert raw b'\"context\":\"PC_SIM\",' immediately after the first opening root ASCII { before existing context; duplicate object key is rejected at parser level"
  }
